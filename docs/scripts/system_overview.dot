digraph SystemOverview {
  rankdir=TB;
  node [shape=box, style=filled, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=8];

  // System: Ball Handler Test Platform
  // Version: 1.0

  subgraph cluster_hardware {
    label="Hardware Components";
    style=filled;
    color=lightblue;
    subgraph cluster_motor_controllers {
      label="Motor Controllers";
      style=filled;
      color=lightcyan;
      rc1 [label="rc1\nCOM5", fillcolor=cyan];
      rc2 [label="rc2\nCOM4", fillcolor=cyan];
    }
    subgraph cluster_sensors {
      label="Sensors";
      style=filled;
      color=lightgreen;
      optical_flow [label="optical_flow\nPAA5100JE-Q", fillcolor=lightgreen];
      current_monitoring [label="current_monitoring\nINA219", fillcolor=lightgreen];
    }
    maker_pi [label="maker_pi\nMaker Pi RP2040", fillcolor=lightyellow];
  }

  subgraph cluster_software {
    label="Software Modules";
    style=filled;
    color=lightpink;
    subgraph cluster_core_modules {
      label="Core Modules";
      style=filled;
      color=lightcoral;
      platform_control [label="platform_control\nMain platform control process ...", fillcolor=coral];
      roboclaw_interface [label="roboclaw_interface\nRoboClaw-specific motor contro...", fillcolor=coral];
      roboclaw_control [label="roboclaw_control\nRoboClaw-specific motion contr...", fillcolor=coral];
      setpoint_generator [label="setpoint_generator\nRoboClaw-specific setpoint gen...", fillcolor=coral];
      kinematic_conversion [label="kinematic_conversion\nKinematic transformations for ...", fillcolor=coral];
    }
    subgraph cluster_sensor_modules {
      label="Sensor Modules";
      style=filled;
      color=lightsteelblue;
      power_sensor [label="power_sensor\nINA219 power sensor interface", fillcolor=steelblue];
      optical_flow_sensor [label="optical_flow_sensor\nPAA5100JE-Q optical flow senso...", fillcolor=steelblue];
    }
    subgraph cluster_test_modules {
      label="Test Modules";
      style=filled;
      color=lightgoldenrod;
      connectivity_test [label="connectivity_test\nSystem-wide connectivity tests...", fillcolor=goldenrod];
      roboclaw_test [label="roboclaw_test\nRoboClaw error state and pin d...", fillcolor=goldenrod];
      calibration_test [label="calibration_test\nComprehensive RoboClaw motor c...", fillcolor=goldenrod];
      motor_control_test [label="motor_control_test\nRoboClaw motor control and cur...", fillcolor=goldenrod];
      system_test [label="system_test\nSystem-wide test orchestration", fillcolor=goldenrod];
    }
  }

  // Dependencies
  raspberry_pi_5 -> roboclaw_interface [color=blue, label="controls"];
  raspberry_pi_5 -> optical_flow_sensor [color=green, label="senses"];
  raspberry_pi_5 -> power_sensor [color=red, label="monitors"];
  platform_control -> roboclaw_interface [color=purple, label="depends"];
  platform_control -> roboclaw_control [color=purple, label="depends"];
  platform_control -> power_sensor [color=purple, label="depends"];
  platform_control -> optical_flow_sensor [color=purple, label="depends"];
  roboclaw_interface -> roboclaw_3_py [color=purple, label="depends"];
  roboclaw_interface -> platform_config_json [color=purple, label="depends"];
  roboclaw_control -> roboclaw_interface [color=purple, label="depends"];
  setpoint_generator -> numpy [color=purple, label="depends"];
  kinematic_conversion -> numpy [color=purple, label="depends"];
}